
def to_binary(n):
    """Convert an integer to 8-bit 2's complement."""
    return format(n & 0xFF, '08b')


def signed_value(binary):
    """Convert 8-bit binary to signed decimal."""
    value = int(binary, 2)
    if value >= 128:
        value -= 256
    return value


def add_binary(a, b):
    bin_a = to_binary(a)
    bin_b = to_binary(b)

    # Perform 8-bit binary addition
    result = (int(bin_a, 2) + int(bin_b, 2)) & 0xFF
    result_bin = format(result, '08b')
    result_dec = signed_value(result_bin)

    # Overflow occurs when operands have the same sign
    # but the result has a different sign.
    overflow = (
        (bin_a[0] == bin_b[0]) and
        (result_bin[0] != bin_a[0])
    )

    print(f"Operand 1: {a:4d} = {bin_a}")
    print(f"Operand 2: {b:4d} = {bin_b}")
    print(f"Result   : {result_bin} = {result_dec}")
    print("Overflow :", "Yes" if overflow else "No")
    print("-" * 40)


print("(a) 120 + (+62)")
add_binary(120, 62)

print("(b) (-120) + (-62)")
add_binary(-120, -62)
